apiVersion: v1
kind: Secret
metadata:
  name: qbit-secrets
type: Opaque
stringData:
  AIRVPN_WG_PRIVATE_KEY: "${AIRVPN_WG_PRIVATE_KEY}"
  AIRVPN_WG_PRESHARED_KEY: "${AIRVPN_WG_PRESHARED_KEY}"
  AIRVPN_WG_ADDRESSES: "${AIRVPN_WG_ADDRESSES}"
  AIRVPN_INPUT_PORT: "${AIRVPN_INPUT_PORT}"
  AIRVPN_SERVER_REGIONS: "${AIRVPN_SERVER_REGIONS}"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: qbit-configs
data:
  QBIT_PUID: "${QBIT_PUID}"
  QBIT_PGID: "${QBIT_PGID}"
  QBIT_TZ: "${QBIT_TZ}"
  QBIT_WEBUI_PORT: "${QBIT_WEBUI_PORT}"
  QBIT_CONFIG: "${QBIT_CONFIG}"
  QBIT_DOWNLOADS: "${QBIT_DOWNLOADS}"
---
apiVersion: v1
kind: Pod
metadata:
  name: qbit-pod
spec:
  containers:
    - name: gluetun
      image: docker.io/qmcgaw/gluetun:v3
      securityContext:
        capabilities:
          add: ["NET_ADMIN"]
      ports:
        - containerPort: 8080
          hostPort: 8080
      volumeMounts:
        - mountPath: /dev/net/tun
          name: dev-tun
      env:
        - name: VPN_SERVICE_PROVIDER
          value: airvpn
        - name: VPN_TYPE
          value: wireguard
        - name: WIREGUARD_PRIVATE_KEY
          valueFrom:
            secretKeyRef:
              name: qbit-secrets
              key: AIRVPN_WG_PRIVATE_KEY
        - name: WIREGUARD_PRESHARED_KEY
          valueFrom:
            secretKeyRef:
              name: qbit-secrets
              key: AIRVPN_WG_PRESHARED_KEY
        - name: WIREGUARD_ADDRESSES
          valueFrom:
            secretKeyRef:
              name: qbit-secrets
              key: AIRVPN_WG_ADDRESSES
        - name: SERVER_REGIONS
          valueFrom:
            secretKeyRef:
              name: qbit-secrets
              key: AIRVPN_SERVER_REGIONS
        - name: FIREWALL_VPN_INPUT_PORTS
          valueFrom:
            secretKeyRef:
              name: qbit-secrets
              key: AIRVPN_INPUT_PORT

    - name: qbittorrent
      image: docker.io/linuxserver/qbittorrent:5.1.4
      volumeMounts:
        - mountPath: /config
          name: qbit-config
        - mountPath: /downloads
          name: qbit-downloads
      env:
        - name: PUID
          valueFrom:
            configMapKeyRef:
              name: qbit-configs
              key: QBIT_PUID
        - name: PGID
          valueFrom:
            configMapKeyRef:
              name: qbit-configs
              key: QBIT_PGID
        - name: TZ
          valueFrom:
            configMapKeyRef:
              name: qbit-configs
              key: QBIT_TZ
        - name: WEBUI_PORT
          valueFrom:
            configMapKeyRef:
              name: qbit-configs
              key: QBIT_WEBUI_PORT
        - name: TORRENTING_PORT
          valueFrom:
            secretKeyRef:
              name: qbit-secrets
              key: AIRVPN_INPUT_PORT

  volumes:
    - name: dev-tun
      hostPath:
        path: /dev/net/tun

    - name: qbit-config
      hostPath:
        path: ${QBIT_CONFIG}
        type: DirectoryOrCreate

    - name: qbit-downloads
      hostPath:
        path: ${QBIT_DOWNLOADS}
        type: DirectoryOrCreate
